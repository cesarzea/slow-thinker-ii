{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slow-thinker-ii:contracts:graph:0.1-draft",
  "title": "Graph contract — proposal 0.1-draft",
  "description": "Review artifact only. Not an approved or implemented API.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "graph_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "derived_from": {
      "type": "object",
      "properties": {
        "graph_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "graph_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/instance"
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        }
      },
      "required": [
        "component",
        "operation"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "caller": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "caller",
          "target",
          "operations"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "limits_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9.-]+:[A-Za-z0-9._-]+$": {}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "graph_id",
    "revision",
    "components",
    "controller",
    "nodes",
    "permissions",
    "limits_profile"
  ],
  "additionalProperties": false,
  "$defs": {
    "instance": {
      "type": "object",
      "properties": {
        "type_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "type_version": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        },
        "resources": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          }
        }
      },
      "required": [
        "type_id",
        "type_version",
        "config",
        "resources"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          }
        }
      },
      "required": [
        "component",
        "operation",
        "inputs"
      ],
      "additionalProperties": false
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "literal"
            },
            "value": {}
          },
          "required": [
            "source",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "run_input"
            },
            "pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            }
          },
          "required": [
            "source",
            "pointer"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "node_output"
            },
            "node": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "pointer": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            }
          },
          "required": [
            "source",
            "node",
            "pointer"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
