{
  "schema_version": "0.1-draft",
  "type_id": "redirector",
  "type_version": "0.1.0",
  "roles": [
    "resource"
  ],
  "operations": {
    "route": {
      "mcp_tool": "route",
      "input_schema": {
        "type": "object",
        "properties": {
          "value": {}
        },
        "required": [
          "value"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "port": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "port"
        ],
        "additionalProperties": false
      }
    }
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "outputs": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "selector": {
        "type": "string",
        "pattern": "^[A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*:[A-Za-z_]\\w*$"
      },
      "input_schema": {
        "type": "object"
      }
    },
    "required": [
      "outputs",
      "selector",
      "input_schema"
    ],
    "additionalProperties": false
  },
  "resource_slots": {},
  "execution": {
    "state_scope": "none",
    "concurrency": "independent"
  },
  "billing": "none"
}
