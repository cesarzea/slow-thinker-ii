{
  "schema_version": "0.1-draft",
  "type_id": "bounded-flow",
  "type_version": "0.1.0",
  "roles": [
    "control"
  ],
  "operations": {
    "next": {
      "mcp_tool": "next",
      "input_schema": {
        "type": "object",
        "properties": {
          "completed": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "node": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "node",
                "port"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "completed"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "activate"
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "maxItems": 1
              }
            },
            "required": [
              "action",
              "nodes"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "complete"
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "exhausted"
              },
              "reason": {
                "const": "activation_limit_reached"
              }
            },
            "required": [
              "action",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "entry": {
        "type": "string",
        "minLength": 1
      },
      "routes": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "type": "string",
          "minLength": 1
        },
        "additionalProperties": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "max_activations": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "entry",
      "routes",
      "max_activations"
    ],
    "additionalProperties": false
  },
  "resource_slots": {},
  "execution": {
    "state_scope": "none",
    "concurrency": "independent"
  },
  "billing": "none"
}
