{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slow-thinker-ii:contracts:event:0.1-draft",
  "title": "Event contract — proposal 0.1-draft",
  "description": "Review artifact only. Not an approved or implemented API.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1-draft"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "graph_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "graph_revision": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "platform",
            "component",
            "analyzer"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "enum": [
        "observed",
        "reported",
        "inferred"
      ]
    },
    "activation_id": {
      "type": "string",
      "minLength": 1
    },
    "call_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_call_id": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9.-]+:[A-Za-z0-9._-]+$": {}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "graph_id",
    "graph_revision",
    "sequence",
    "occurred_at",
    "event_type",
    "actor",
    "evidence",
    "data"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence": {
            "const": "observed"
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "platform"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "const": "reported"
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "component"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence": {
            "const": "inferred"
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "kind": {
                "const": "analyzer"
              }
            }
          }
        }
      }
    }
  ]
}
