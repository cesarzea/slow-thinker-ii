{
  "format": "slow-thinker.component/1",
  "type": "llm-call",
  "version": "1.0.0",
  "label": "LLM Call",
  "description": "Sends its prompt and the received message to one LLM and emits the reply.",
  "icon": "agent",
  "placements": ["node"],
  "state": "stateless",
  "ports": {"inputs": ["in"], "outputs": ["out"]},
  "uses": [{"service": "llm", "pointer": "/model"}],
  "config_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["prompt", "model", "input_format", "output_format"],
    "properties": {
      "prompt": {"type": "string", "minLength": 1, "maxLength": 100000},
      "model": {"type": ["object", "null"]},
      "input_format": {"type": ["object", "null"]},
      "output_format": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {"enum": ["text", "json"]},
          "schema": {"type": "object"}
        },
        "if": {"properties": {"type": {"const": "json"}}},
        "then": {"required": ["schema"]}
      }
    }
  },
  "initial_config": {"prompt": "", "model": null, "input_format": null, "output_format": {"type": "text"}},
  "ui": {
    "card": ["/prompt", "/model"],
    "sections": [
      {"id": "prompt", "title": "Prompt", "fields": [
        {"path": "/prompt", "control": "multiline", "label": "Instructions",
         "help": "Sent to the model as system instructions. The received message is sent as the user message."}
      ]},
      {"id": "model", "title": "Model", "fields": [
        {"path": "/model", "control": "service", "service": "llm", "label": "LLM",
         "help": "Only LLMs configured on this platform are listed."}
      ]},
      {"id": "input", "title": "Input format", "fields": [
        {"path": "/input_format", "control": "schema", "label": "Expected input", "empty_label": "Any text",
         "help": "Optional. With a schema, a message that does not match fails the activation before the model is called."}
      ]},
      {"id": "output", "title": "Output format", "fields": [
        {"path": "/output_format/type", "control": "choice", "label": "Format",
         "options": [{"value": "text", "label": "Text"}, {"value": "json", "label": "JSON"}]},
        {"path": "/output_format/schema", "control": "schema", "label": "JSON schema",
         "help": "The reply is validated. An invalid reply fails the activation and is kept for inspection.",
         "when": {"path": "/output_format/type", "equals": "json"}}
      ]}
    ]
  }
}
