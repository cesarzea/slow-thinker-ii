      {
        "type_id": "example.sequence",
        "type_version": "0.1.0-example",
        "resolution_id": "00000000000000000000000000000000",
        "host_adapter": "mcp"
      },
      {
        "type_id": "llm-call",
        "type_version": "0.1.0-example",
        "resolution_id": "00000000000000000000000000000000",
        "host_adapter": "openai-client"
      },
      {
        "type_id": "example.model-resource",
        "type_version": "0.1.0-example",
        "resolution_id": "00000000000000000000000000000000",
        "host_adapter": "openai-model"
      }
    ],
    "providers": {
      "illustrative-provider": {
        "model": "gpt-6-luna",
        "returned_models": ["gpt-6-luna"],
