{
  "schema_version": "1",
  "revision": "local-1",
  "limits": {
    "revision": "illustrative-limits",
    "run_seconds": 120,
    "call_seconds": 60,
    "startup_seconds": 20,
    "shutdown_seconds": 5,
    "max_calls": 100,
    "max_depth": 8,
    "max_payload_bytes": 1048576,
    "run_budget": 100000000,
    "session_budget": 1000000000,
    "month_budget": 5000000000
