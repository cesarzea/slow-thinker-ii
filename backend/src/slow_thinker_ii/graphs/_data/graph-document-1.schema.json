{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:slow-thinker:schema:graph-document:1",
  "title": "Slow Thinker graph document, format 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "id", "name", "limits", "nodes", "connections"],
  "properties": {
    "format": {"const": "slow-thinker.graph/1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "limits": {"$ref": "#/$defs/limits"},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/node"}},
    "connections": {"type": "array", "maxItems": 2000, "items": {"$ref": "#/$defs/connection"}},
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "connections": {"enum": ["curved", "simple", "routed"]},
        "curvature": {"type": "number", "minimum": 0, "maximum": 1},
        "observe": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "port_sides": {
      "type": "object",
      "maxProperties": 200,
      "additionalProperties": {
        "type": "object",
        "maxProperties": 64,
        "propertyNames": {"minLength": 1, "maxLength": 40},
        "additionalProperties": {"enum": ["left", "right", "top", "bottom"]}
      }
    },
    "layout": {
      "type": "object",
      "maxProperties": 200,
      "additionalProperties": {
        "type": "array",
        "prefixItems": [
          {"type": "number", "minimum": -1000000, "maximum": 1000000},
          {"type": "number", "minimum": -1000000, "maximum": 1000000}
        ],
        "items": false,
        "minItems": 2
      }
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_activations", "max_running_nodes", "time_limit_seconds", "budget_usd"],
      "properties": {
        "max_activations": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_running_nodes": {"type": "integer", "minimum": 1, "maximum": 64},
        "time_limit_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "budget_usd": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,5})(\\.[0-9]{1,9})?$"}
      }
    },
    "componentRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "component", "config"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S"},
        "component": {"$ref": "#/$defs/componentRef"},
        "config": {"type": "object"},
        "embedded": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/embedded"}}
      }
    },
    "embedded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "component", "config"],
      "properties": {
        "position": {"enum": ["output", "memory"]},
        "component": {"$ref": "#/$defs/componentRef"},
        "config": {"type": "object"}
      }
    },
    "portRef": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}\\.[a-z][a-z0-9_]{0,31}$"},
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"$ref": "#/$defs/portRef"},
        "to": {"$ref": "#/$defs/portRef"}
      }
    }
  }
}
